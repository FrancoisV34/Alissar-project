{
  "name": "alissar-vitrine",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"vite\"",
    "server": "nodemon server/index.js",
    "seed": "node server/seed.js",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "db:migrate": "node -e \"import('./server/db.js').then(async ({default: db}) => (await import('./server/lib/migrate.js')).migrate(db))\"",
    "db:backup": "node server/scripts/db-backup.js",
    "db:restore": "node server/scripts/db-restore.js",
    "db:seed-test": "node server/seed-test.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@mantine/core": "^8.3.16",
    "@mantine/hooks": "^8.3.16",
    "@tanstack/react-query": "^5.90.21",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.6.2",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dompurify": "^3.2.4",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "postcss": "^8.5.8",
    "postcss-preset-mantine": "^1.18.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.13.1",
    "sanitize-html": "^2.14.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@eslint/js": "^9.36.0",
    "@flydotio/dockerfile": "^0.7.10",
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^4.1.12",
    "concurrently": "^9.2.1",
    "eslint": "^9.36.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "eslint-plugin-security": "^3.0.1",
    "fast-check": "^4.1.1",
    "globals": "^16.4.0",
    "jsdom": "^26.1.0",
    "nodemon": "^3.1.14",
    "sass-embedded": "^1.93.2",
    "supertest": "^7.1.1",
    "vite": "^7.1.7",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22"
  }
}
