# Port d'écoute du serveur Node
PORT=3001

# Secret JWT — OBLIGATOIRE en production (≥ 32 caractères aléatoires)
# Générer un secret avec :  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change_me_to_a_random_64_char_string

# Compte admin créé automatiquement au 1er démarrage (si aucun admin n'existe).
# Si non définis, un mot de passe aléatoire sera généré et logué une fois.
ADMIN_EMAIL=admin@alissar-osteo.fr
ADMIN_PASSWORD=change_me

# Optionnel : chemins persistants (utile en prod avec volume monté)
# DATABASE_PATH=/data/database.sqlite
# UPLOADS_PATH=/data/uploads

# Optionnel : forcer le mode prod (sinon NODE_ENV est défini par le script start)
# NODE_ENV=production
